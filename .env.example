# ─────────────────────────────────────────────────────────────
# COMFYCLUB environment variables
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Supabase — from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://comfyclub.pk
NEXT_PUBLIC_WHATSAPP_NUMBER=923394100052
NEXT_PUBLIC_CONTACT_EMAIL=comfyclub.pk@gmail.com

# Analytics (added/used in Phase 12) — leave blank for now
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# Email — Resend (used in Phase 11/Contact) — leave blank for now
RESEND_API_KEY=

# Rate limiting — Upstash Redis (used in Phase 6) — leave blank for now
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job protection (used in Phase 4/10) — any long random string
CRON_SECRET=
